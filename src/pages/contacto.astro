---
import BaseLayout from '../layouts/BaseLayout.astro';
import BusinessHours from '../components/BusinessHours.astro';
import { BUSINESS } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';
import { withBase } from '../lib/url';

const { lat, lng } = BUSINESS.geo;
const mapSrc = `https://www.google.com/maps?q=${lat},${lng}&output=embed`;
const waText = encodeURIComponent('Hola, quisiera más información');

interface Row { label: string; value: string; href: string; external?: boolean; fill?: boolean; icon: string }
const rows: Row[] = [
  { label: 'WhatsApp', value: BUSINESS.phoneDisplay, href: `https://wa.me/${BUSINESS.whatsappNumber}?text=${waText}`, external: true, fill: true,
    icon: 'M12 2a10 10 0 0 0-8.66 15L2 22l5.14-1.32A10 10 0 1 0 12 2zm5.6 14.3c-.24.66-1.38 1.26-1.9 1.33-.5.07-1.03.1-3.3-.7-2.78-1.02-4.57-3.86-4.7-4.04-.14-.18-1.12-1.5-1.12-2.85s.7-2.02.95-2.3c.24-.27.53-.34.7-.34h.5c.16 0 .38-.06.6.44.24.55.8 1.9.86 2.04.07.14.11.3.02.48-.09.18-.14.3-.28.45-.14.16-.29.36-.42.48-.14.13-.28.28-.12.55.16.27.7 1.16 1.52 1.88 1.05.94 1.93 1.23 2.2 1.37.27.14.43.12.6-.07.16-.2.68-.79.87-1.06.18-.27.36-.22.6-.13.24.09 1.55.73 1.82.86.27.14.44.2.5.32.07.11.07.66-.17 1.3z' },
  { label: 'Teléfono', value: BUSINESS.phoneDisplay, href: `tel:${BUSINESS.phoneE164}`,
    icon: 'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.4 2.1L8 9.9a16 16 0 0 0 6 6l1.4-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.7.6a2 2 0 0 1 1.8 2.1z' },
  { label: 'Correo', value: BUSINESS.email, href: `mailto:${BUSINESS.email}`, icon: 'M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM2 6l10 7 10-7' },
  { label: 'Facebook', value: 'G2 Creatividad Guatemala', href: BUSINESS.facebook, external: true, fill: true,
    icon: 'M13.5 22v-8.5H16l.5-3.5h-3V7.7c0-1 .3-1.7 1.7-1.7H16.6V2.8C16.3 2.8 15.3 2.7 14.2 2.7c-2.4 0-4 1.4-4 4v2.3H7.7v3.5h2.5V22h3.3z' },
  { label: 'Dirección', value: `${BUSINESS.address.street}, ${BUSINESS.address.neighborhood}`, href: BUSINESS.googleMaps, external: true,
    icon: 'M21 10c0 6-9 12-9 12s-9-6-9-12a9 9 0 0 1 18 0zM12 7a3 3 0 1 0 0 6 3 3 0 0 0 0-6z' },
  { label: 'Waze', value: 'Cómo llegar', href: BUSINESS.waze, external: true,
    icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM8 15c1 1 2.2 1.5 4 1.5s3-.5 4-1.5M9 10h.01M15 10h.01' },
];
const jsonLd = [breadcrumbSchema([{ name: 'Inicio', path: '/' }, { name: 'Contacto', path: '/contacto/' }])];
---
<BaseLayout
  title="Contacto y ubicación | G2 Creatividad en zona 12"
  description="Contacta a G2 Creatividad: WhatsApp y teléfono 4220-3700, correo, horario de atención y ubicación en la 28 calle 0-47 zona 12, Ciudad de Guatemala."
  current="contacto"
  jsonLd={jsonLd}
>
  <section class="contact section-pad" style="padding-top: calc(88px + clamp(3rem,6vw,5rem));">
    <div class="container">
      <div class="section-head reveal">
        <div class="eyebrow">Contacto</div>
        <h1 class="h-lg">Hablemos de tu proyecto.</h1>
        <p class="lede" style="margin-top:.8rem;">Escríbenos por WhatsApp, visítanos en zona 12 o encuéntranos en redes.</p>
      </div>

      <div class="contact__grid">
        <ul class="contact__list reveal">
          {rows.map((r) => (
            <li>
              <a class="contact__row" href={r.href} target={r.external ? '_blank' : undefined} rel={r.external ? 'noopener' : undefined}>
                <svg viewBox="0 0 24 24" fill={r.fill ? 'currentColor' : 'none'} stroke={r.fill ? 'none' : 'currentColor'} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={r.icon} /></svg>
                <span><span class="lbl">{r.label}</span><span class="val">{r.value}</span></span>
              </a>
            </li>
          ))}
        </ul>

        <div class="map-frame reveal">
          <iframe src={mapSrc} loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Mapa con la ubicación de G2 Creatividad"></iframe>
        </div>

        <div class="reveal"><BusinessHours /></div>

        <div class="contact__cta reveal">
          <h2 class="h-md">¿Quieres una cotización?</h2>
          <p>Cuéntanos qué necesitas con nuestro cotizador y te escribimos por WhatsApp con el mensaje ya armado.</p>
          <a class="btn btn-solid" href={withBase('/cotizar/')}>Ir al cotizador</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact{ position:relative; z-index:1; }
  .contact__grid{ display:grid; grid-template-columns: 1fr 1fr; gap: 2rem 3rem; align-items:start; }
  .contact__list{ display:grid; gap:1rem; }
  .contact__row{ display:flex; align-items:center; gap:1rem; min-height:64px; padding: 1.1rem 1.2rem; background: var(--bg-raised); border:1px solid var(--border); border-radius: var(--radius-sm); transition: border-color .25s, transform var(--spring-dur) var(--spring); }
  .contact__row:hover{ border-color: var(--accent-ink); transform: translateX(4px); }
  .contact__row:active{ transform: scale(.99); }
  .contact__row svg{ flex:none; width:22px; height:22px; color:var(--accent-ink); }
  .contact__row .lbl{ font-size:.8rem; color:var(--text-muted); display:block; }
  .contact__row .val{ font-weight:600; font-size:.98rem; overflow-wrap:anywhere; }
  .map-frame{ border:1px solid var(--border); border-radius: var(--radius-sm); overflow:hidden; aspect-ratio: 4/3.4; filter: grayscale(.15); }
  .map-frame iframe{ width:100%; height:100%; border:0; }
  html[data-theme="dark"] .map-frame{ filter: grayscale(.4) invert(.92) contrast(.9); }
  .contact__cta{ padding:1.5rem; border:1px solid var(--border); background:var(--bg-raised); display:grid; gap:1rem; align-content:start; }
  .contact__cta p{ color:var(--text-muted); }
  .contact__cta .btn{ justify-self:start; }
  @media (max-width:900px){ .contact__grid{ grid-template-columns:1fr; } }
</style>
