---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Marquee from '../components/home/Marquee.astro';
import Stats from '../components/home/Stats.astro';
import About from '../components/home/About.astro';
import Materials from '../components/home/Materials.astro';
import ServicesTeaser from '../components/home/ServicesTeaser.astro';
import { YEARS_OF_EXPERIENCE } from '../data/site';
---
<BaseLayout
  title="G2 Creatividad | Rotulación y sandblast en Guatemala"
  description={`G2 Creatividad: ${YEARS_OF_EXPERIENCE} años de trayectoria en rótulos de acrílico, PVC y ACM, letras tipo block, vinil de corte, impresión full color y sandblast en Guatemala.`}
  current="inicio"
>
  <Hero />
  <Marquee />
  <Stats />
  <About />
  <Materials />
  <ServicesTeaser />
</BaseLayout>
