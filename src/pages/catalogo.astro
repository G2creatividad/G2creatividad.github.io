---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SERVICES } from '../data/services';
import { numberWord } from '../lib/text';
import { breadcrumbSchema } from '../lib/schema';
import { withBase } from '../lib/url';
import '../styles/catalog.css';

const jsonLd = [breadcrumbSchema([{ name: 'Inicio', path: '/' }, { name: 'Catálogo', path: '/catalogo/' }])];
---
<BaseLayout
  title="Catálogo de rótulos y servicios | G2 Creatividad"
  description="Catálogo de G2 Creatividad: rótulos en acrílico, PVC y ACM, letras tipo block, vinil, impresión, seguridad industrial y sandblast en Guatemala."
  current="catalogo"
  jsonLd={jsonLd}
>
  <section class="section-pad" style="padding-top: calc(88px + clamp(3rem,6vw,5rem));">
    <div class="container">
      <div class="section-head reveal">
        <div class="eyebrow">Catálogo</div>
        <h1 class="h-lg">{numberWord(SERVICES.length)} especialidades, un solo taller.</h1>
        <p class="lede" style="margin-top:.8rem;">Desde una vitrina hasta la fachada completa de una planta industrial: elegimos el material y el proceso que mejor le conviene a tu proyecto. Entra a cada servicio para ver detalles, o cotiza directo: el botón abre WhatsApp con el mensaje ya listo para ese servicio.</p>
      </div>

      <div class="catalog__grid reveal">
        {SERVICES.map((service) => <ServiceCard service={service} headingLevel={2} />)}
      </div>

      <p class="catalog__note reveal">
        ¿No sabes qué material elegir? <a href={withBase('/cotizar/')}>Cuéntanos tu proyecto</a> y te recomendamos la mejor opción.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .catalog__note{ margin-top:2rem; color:var(--text-muted); }
  .catalog__note a{ color:var(--accent-ink); text-decoration:underline; text-underline-offset:3px; }
</style>
