---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SERVICES, servicePath } from '../data/services';
import { withBase } from '../lib/url';
---
<BaseLayout
  title="Página no encontrada | G2 Creatividad"
  description="La página que buscas no existe o cambió de dirección. Vuelve al inicio o explora el catálogo de G2 Creatividad."
  noindex
>
  <section class="nf section-pad" style="padding-top: calc(88px + clamp(3rem,8vw,6rem));">
    <div class="container">
      <p class="nf__code mono" aria-hidden="true">Error 404</p>
      <h1 class="h-xl">Esta página no existe.</h1>
      <p class="lede" style="margin-top:1rem;">Puede que el enlace haya cambiado o esté mal escrito. Estos son los caminos más rápidos:</p>
      <div class="nf__ctas">
        <a class="btn btn-solid" href={withBase('/')}>Ir al inicio</a>
        <a class="btn btn-outline" href={withBase('/cotizar/')}>Cotizar un proyecto</a>
      </div>
      <ul class="nf__list">
        {SERVICES.map((s) => <li><a href={withBase(servicePath(s.slug))}>{s.title}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf{ position:relative; z-index:1; min-height:70svh; }
  .nf__code{ color:var(--accent-ink); margin-bottom:1rem; }
  .nf__ctas{ display:flex; flex-wrap:wrap; gap:1rem; margin:2rem 0; }
  .nf__list{ display:flex; flex-wrap:wrap; gap:.5rem 1.5rem; }
  .nf__list a{ display:inline-flex; align-items:center; min-height:44px; color:var(--text-muted); text-decoration:underline; text-underline-offset:3px; }
  .nf__list a:hover{ color:var(--accent-ink); }
</style>
