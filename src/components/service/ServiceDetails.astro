---
import type { Service } from '../../data/services';

interface Props { service: Service }
const { service } = Astro.props;
---
<section class="sdet section-pad">
  <div class="container sdet__grid">
    <div class="reveal">
      <h2 class="h-md">¿Para qué se usa?</h2>
      <ul class="sdet__uses">
        {service.uses.map((u) => (
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>{u}</li>
        ))}
      </ul>
    </div>
    <div class="reveal">
      <h2 class="h-md">Por qué elegirlo</h2>
      <dl class="sdet__benefits">
        {service.benefits.map((b) => (
          <div><dt>{b.title}</dt><dd>{b.text}</dd></div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .sdet{ position:relative; z-index:1; background:var(--surface); border-block:1px solid var(--border); }
  .sdet__grid{ display:grid; grid-template-columns: 1fr 1.2fr; gap: clamp(2rem,5vw,5rem); }
  .sdet h2{ margin-bottom:1.5rem; }
  .sdet__uses{ display:grid; gap:.25rem; }
  .sdet__uses li{ display:flex; gap:.75rem; align-items:flex-start; padding:.75rem 0; border-top:1px solid var(--border); color:var(--text-muted); }
  .sdet__uses svg{ flex:none; width:18px; height:18px; margin-top:.2rem; color:var(--accent-ink); }
  .sdet__benefits{ margin:0; }
  .sdet__benefits > div{ padding:1rem 0; border-top:1px solid var(--border); }
  .sdet__benefits dt{ font-family:var(--font-display); font-weight:700; font-size:1.2rem; }
  .sdet__benefits dd{ margin:.25rem 0 0; color:var(--text-muted); font-size:.95rem; }
  @media (max-width:900px){ .sdet__grid{ grid-template-columns:1fr; } }
</style>
