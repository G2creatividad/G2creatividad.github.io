---
import { BUSINESS } from '../../data/site';
import { whatsappLinkFor, type Service } from '../../data/services';
import { withBase } from '../../lib/url';

interface Props { service: Service }
const { service } = Astro.props;
---
<section class="shero">
  <div class="container shero__grid">
    <div>
      <nav aria-label="Migas de pan" class="crumbs">
        <ol>
          <li><a href={withBase('/')}>Inicio</a></li>
          <li><a href={withBase('/catalogo/')}>Catálogo</a></li>
          <li aria-current="page">{service.title}</li>
        </ol>
      </nav>
      <h1 class="h-xl">{service.h1}</h1>
      <p class="lede">{service.intro}</p>
      <div class="shero__ctas">
        <a href="#cotizar" class="btn btn-solid">Cotizar este servicio</a>
        <a href={whatsappLinkFor(service, BUSINESS.whatsappNumber)} class="btn btn-outline" target="_blank" rel="noopener">Escribir por WhatsApp</a>
      </div>
    </div>

    <aside class="sheet reg-corners" aria-label="Ficha técnica">
      <svg class="sheet__icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width=".9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={service.icon} />
      <p class="sheet__title mono">Ficha técnica</p>
      <dl>
        {service.specs.map((s) => (
          <div><dt class="mono">{s.label}</dt><dd>{s.value}</dd></div>
        ))}
      </dl>
    </aside>
  </div>
</section>

<style>
  .shero{ position:relative; z-index:1; padding: calc(88px + clamp(2.5rem,5vw,4rem)) 0 clamp(3rem,6vw,5rem); }
  .shero__grid{ display:grid; grid-template-columns: minmax(0,1.25fr) minmax(0,1fr); gap: clamp(2rem,5vw,4.5rem); align-items:center; }
  .crumbs ol{ display:flex; flex-wrap:wrap; gap:.5rem; margin:0 0 1.5rem; padding:0; list-style:none; font-size:.85rem; color:var(--text-muted); }
  .crumbs li + li::before{ content:"/"; margin-right:.5rem; color:var(--accent-ink); }
  .crumbs a{ text-decoration:underline; text-underline-offset:3px; }
  .crumbs a:hover{ color:var(--accent-ink); }
  .shero h1{ margin-bottom:1.25rem; }
  .shero__ctas{ display:flex; flex-wrap:wrap; gap:1rem; margin-top:2rem; }
  .sheet{ position:relative; background:var(--panel); color:var(--panel-text); padding:2rem; clip-path: polygon(0 0, 100% 0, 100% 100%, 6% 100%); overflow:hidden; }
  .sheet__icon{ position:absolute; right:-24px; top:-24px; width:220px; height:220px; color:var(--accent); opacity:.14; }
  .sheet__title{ position:relative; margin-bottom:1rem; color:rgba(255,255,255,.7); }
  .sheet dl{ position:relative; margin:0; }
  .sheet dl > div{ display:grid; grid-template-columns: 8.5rem 1fr; gap:1rem; padding:.9rem 0; border-top:1px solid rgba(255,255,255,.14); }
  .sheet dt{ color:rgba(255,255,255,.7); font-size:.78rem; }
  .sheet dd{ margin:0; font-weight:600; color:#fff; }
  @media (max-width:900px){ .shero__grid{ grid-template-columns:1fr; } .sheet dl > div{ grid-template-columns: 7rem 1fr; } }
</style>
