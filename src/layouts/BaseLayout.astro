---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CursorGridBackground from '../components/CursorGridBackground.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  current?: string;
}
const {
  title,
  description = '22 años de trayectoria en rótulos de acrílico, PVC y ACM, letras tipo block, vinil de corte, impresión full color, seguridad industrial y sandblast en Guatemala.',
  current = ''
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script is:inline>
    // Set theme before first paint to avoid a flash of the wrong theme.
    (function(){
      var stored = null;
      try { stored = sessionStorage.getItem('g2-theme'); } catch(e){}
      var theme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Saltar al contenido</a>
  <CursorGridBackground />
  <Nav current={current} />
  <main id="main" style="position:relative; z-index:1;">
    <slot />
  </main>
  <Footer />

  <script is:inline>
    // Persist theme choice for the current tab session (no cross-session
    // storage, kept intentionally lightweight).
    window.addEventListener('g2:themechange', function(e){
      try { sessionStorage.setItem('g2-theme', e.detail.theme); } catch(err){}
    });
  </script>

  <script>
    // Shared scroll-reveal, used sparingly across pages.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealEls = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window && !reduceMotion) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) { en.target.classList.add('is-visible'); io.unobserve(en.target); }
        });
      }, { threshold: 0.15 });
      revealEls.forEach((el) => io.observe(el));
    } else {
      revealEls.forEach((el) => el.classList.add('is-visible'));
    }
  </script>
</body>
</html>
